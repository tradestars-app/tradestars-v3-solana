{
  "name": "tradestars-arena",
  "version": "0.1.0",
  "type": "module",
  "description": "TradeStars Arena - Solana program for the TradeStars MVP",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "test": "anchor test --skip-deploy",
    "build": "anchor build",
    "deploy:devnet": "solana program deploy --program-id 2YEsWGLfhsUwDWoFCEZQQeES8KN9jHHRXLkbtwoDQGV8 --upgrade-authority ~/.config/solana/id.json --max-len 800000 --url devnet target/deploy/tradestars_arena.so",
    "smoke:deposit:devnet": "node scripts/devnet-smoke-deposit.mjs",
    "config:wallet-deposit:devnet": "node scripts/devnet-set-wallet-deposit-config.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.0",
    "@solana/spl-token": "^0.3.9",
    "@solana/web3.js": "^1.87.6",
    "canvas-confetti": "^1.9.4",
    "ioredis": "^5.9.2",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/chai": "^4.3.0",
    "@types/ioredis": "^5.0.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.3.5"
  }
}
